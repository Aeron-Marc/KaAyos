APP_NAME="KaAyos"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kaayos
# On Hostinger, database names and usernames are prefixed (e.g., u123456789_kaayos)
DB_USERNAME=kaayos_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=kaayos_cache_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# KaAyos Platform Configuration
KAAYOS_PLATFORM_FEE_PERCENT=10
KAAYOS_BOOKING_EXPIRY_HOURS=24
KAAYOS_MAX_CONCURRENT_JOBS=3
KAAYOS_NO_SHOW_MINUTES=60
KAAYOS_DEFAULT_LOCATION="Tuy, Batangas"

# Chatbot (AI Assistant) Configuration
CHATBOT_PROVIDER=openrouter
CHATBOT_API_KEY=
CHATBOT_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=KaAyos

# ML Service Configuration
# Must point to an external host on shared hosting; FastAPI cannot run on Hostinger
ML_SERVICE_URL=http://127.0.0.1:8001

# Reverb / WebSocket Configuration
# BROADCAST_CONNECTION=log is the shared-hosting fallback; Reverb cannot run here
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_APP_ID=
REVERB_HOST=127.0.0.1
REVERB_PORT=443
REVERB_SCHEME=https
