# Python bytecode cache
__pycache__/
*.pyc
*.pyo

# Virtual environment
.venv/

# Model files (large binaries — optional, uncomment if you don't want them tracked)
# *.pkl
# *.pth
# *.h5

# Data files (keep dataset.csv tracked for reproducibility, ignore temp data)
data/temp/
data/*.csv

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db
